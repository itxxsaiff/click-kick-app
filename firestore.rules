rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return signedIn()
          ? get(/databases/$(database)/documents/users/$(request.auth.uid))
          : null;
    }

    function role() {
      return signedIn() ? userDoc().data.role : '';
    }

    function isStaff() {
      return role() in ['super_admin', 'superAdmin', 'admin', 'employee'];
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isSponsorForContest(contestId) {
      return signedIn() &&
        get(/databases/$(database)/documents/contests/$(contestId)).data.sponsorId == request.auth.uid;
    }

    match /users/{userId} {
      allow create: if isOwner(userId) || isStaff();
      allow read: if signedIn();
      allow update: if isOwner(userId) || isStaff();
      allow delete: if isStaff();
    }

    match /contests/{contestId} {
      allow read: if true;
      allow create, delete: if isStaff();
      allow update: if isStaff() || isSponsorForContest(contestId);

      match /submissions/{submissionId} {
        allow read: if resource.data.status == 'approved' || resource.data.status == 'winner'
          || isOwner(resource.data.userId) || isStaff() || isSponsorForContest(contestId);
        allow create: if signedIn();
        allow update: if isOwner(resource.data.userId)
          || isStaff()
          || (
            signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareCount', 'lastSharedAt'])
            && request.resource.data.shareCount == resource.data.shareCount + 1
          );
        allow delete: if isOwner(resource.data.userId) || isStaff();

        match /sponsor_comments/{commentId} {
          allow read: if isStaff() || isSponsorForContest(contestId) || isOwner(get(/databases/$(database)/documents/contests/$(contestId)/submissions/$(submissionId)).data.userId);
          allow create: if isStaff() || isSponsorForContest(contestId);
          allow update, delete: if isStaff();
        }
      }

      // One user + one video = one vote. Vote docs are written only by the
      // `incrementContestVote` Cloud Function (doc id `{uid}_{submissionId}`;
      // legacy docs used just `{uid}`), so clients can never create them.
      match /votes/{voteId} {
        allow read: if isStaff()
          || isSponsorForContest(contestId)
          || (signedIn() && resource.data.voterId == request.auth.uid);
        allow create: if false;
        allow update, delete: if isStaff();
      }

      match /draw_winners/{winnerId} {
        allow read: if true;
        allow create, update, delete: if isStaff();
      }

      match /review_messages/{messageId} {
        allow read: if isStaff() || isSponsorForContest(contestId);
        allow create: if isStaff() || isSponsorForContest(contestId);
        allow update, delete: if isStaff();
      }
    }

    // Collection-group reads. A fixed-path rule does not authorize
    // collectionGroup('submissions') queries, so this rule authorizes them at
    // any depth: anyone may read approved/winner videos (Search feature), an
    // owner may read their own videos of any status (My Videos dashboard), and
    // staff may read all.
    match /{path=**}/submissions/{submissionId} {
      allow read: if resource.data.status == 'approved'
        || resource.data.status == 'winner'
        || isOwner(resource.data.userId)
        || isStaff();
    }

    // Admin-configured app settings (e.g. sponsorship application fee + prize).
    // Everyone can read the current values; only staff can change them. This is
    // why sponsors were seeing the default $1,100 instead of the admin values.
    match /app_settings/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    match /admin_videos/{videoId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // General (non-competition) user videos. They start `pending` and only
    // staff can approve/reject. Owners can edit the caption or delete their
    // video; view/share counters are written by Cloud Functions.
    match /general_videos/{videoId} {
      allow read: if resource.data.status == 'approved'
        || isOwner(resource.data.userId)
        || isStaff();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.viewCount == 0
        && request.resource.data.shareCount == 0
        && request.resource.data.likeCount == 0;
      allow update: if isStaff()
        || (
          isOwner(resource.data.userId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['caption', 'updatedAt'])
        );
      allow delete: if isOwner(resource.data.userId) || isStaff();

      // One like per user per video, written only by `toggleGeneralVideoLike`
      // (admin SDK, bypasses these rules).
      match /likes/{userId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // Follow graph. Doc id is `{followerId}_{followingId}`.
    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followingId;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.followerId == request.auth.uid || isStaff());
    }

    // Short share links (`/s/{code}`). Anyone (including a signed-out web
    // visitor opening a shared link) must be able to resolve one; only a
    // signed-in user can mint a new one, and they are otherwise immutable.
    match /short_links/{code} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.type is string
        && request.resource.data.params is map;
      allow update: if false;
      allow delete: if isStaff();
    }

    // Public "Click Kick Star" leaderboard: anyone can read; only staff can
    // write moderation state (approved / hidden / removed).
    match /click_kick_star/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /video_reports/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if isStaff();
    }

    match /login_otps/{userId} {
      allow read, write: if false;
    }

    match /support_threads/{threadId} {
      allow create: if isStaff() || (signedIn() && request.auth.uid == threadId);
      allow read: if isStaff() || (signedIn() && request.auth.uid == threadId);
      allow update: if isStaff() || (signedIn() && request.auth.uid == threadId);
      allow delete: if isStaff();

      match /messages/{messageId} {
        allow read: if isStaff() || (signedIn() && request.auth.uid == threadId);
        allow create: if isStaff() || (signedIn() && request.auth.uid == threadId);
        allow update, delete: if isStaff();
      }
    }

    match /sponsorshipApplications/{applicationId} {
      allow create: if signedIn();
      allow read: if isStaff() || isOwner(resource.data.sponsorId);
      allow update: if isStaff() || isOwner(resource.data.sponsorId);
      allow delete: if isStaff();
    }

    match /sponsorship_applications/{applicationId} {
      allow create: if signedIn();
      allow read: if isStaff() || isOwner(resource.data.sponsorId);
      allow update: if isStaff() || isOwner(resource.data.sponsorId);
      allow delete: if isStaff();
    }

    match /payments/{paymentId} {
      allow create: if signedIn();
      allow read: if isStaff() || isOwner(resource.data.userId) || isOwner(resource.data.sponsorId);
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    match /invoices/{invoiceId} {
      allow create: if signedIn();
      allow read: if isStaff() || isOwner(resource.data.userId) || isOwner(resource.data.sponsorId);
      allow update, delete: if isStaff();
    }

    match /auditLogs/{logId} {
      allow read, write: if isStaff();
    }

    match /audit_logs/{logId} {
      allow create: if signedIn();
      allow read, update, delete: if isStaff();
    }

    match /{document=**} {
      allow read, write: if isStaff();
    }
  }
}
